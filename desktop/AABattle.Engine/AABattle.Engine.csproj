<Project Sdk="Microsoft.NET.Sdk">
  <!-- 전투 계산·상태·포텐셜 규칙과 데이터 모델. UI(WinForms) 참조 금지 -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>AABattle.Engine</AssemblyName>
    <RootNamespace>AABattle</RootNamespace>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\research\potentials\potential-catalog.json" LogicalName="potentials.json" />
    <EmbeddedResource Include="..\..\research\abilities\ability-catalog.gz.b64" LogicalName="abilities.b64" />
    <EmbeddedResource Include="..\..\research\moves\move-classification.tsv" LogicalName="move-classification.tsv" />
    <EmbeddedResource Include="..\..\research\items\abaddon-items.txt" LogicalName="items.txt" />
    <EmbeddedResource Include="..\..\lib\reference-data.json" LogicalName="data.json" />
    <EmbeddedResource Include="..\..\lib\reference-aa.json" LogicalName="aa.json" />
    <EmbeddedResource Include="..\..\public\fonts\HeadKasen.ttf" LogicalName="HeadKasen.ttf" />
    <EmbeddedResource Include="..\..\public\fonts\pokemon-bw.otf" LogicalName="pokemon-bw.otf" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AABattle.UI" />
    <InternalsVisibleTo Include="AABattle.Tests" />
  </ItemGroup>
</Project>
